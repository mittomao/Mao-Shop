<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= typeof direction !== 'undefined' ? direction : 'ltr' %>" class="h-full">
<head>
  <%- await include('../partials/head') %>
</head>
<body class="min-h-full flex flex-col font-sans text-slate-800 bg-[#f4f6f8] antialiased">
  <%- await include('../partials/header') %>

  <% if (typeof placeholder === 'function') { %>
    <div class="site-header-custom-slot">
      <%- await placeholder('header') %>
    </div>
  <% } %>

  <main class="flex-1 w-full">
    <% if (typeof placeholder === 'function') { %>
      <%- await placeholder('maincontent') %>
    <% } %>
  </main>

  <% if (typeof placeholder === 'function') { %>
    <div class="site-footer-custom-slot">
      <%- await placeholder('footer') %>
    </div>
  <% } %>

  <%- await include('../partials/footer') %>

  <!-- Global React Islands: Cart & Mobile Drawers, Floating Buttons & Toasts -->
  <div data-react="CartAndMobileDrawers"></div>
  <div data-react="FloatingButtons"></div>

  <!-- React Bundle Scripts -->
  <%- await include('../partials/react-scripts') %>
</body>
</html>
