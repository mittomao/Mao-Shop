<%
  // Prepare safe props from CMS fields
  const heroProps = {
    title: field('Title', 'Siêu Phẩm Công Nghệ'),
    subtitle: field('Subtitle', 'Giá tốt nhất - Bảo hành chính hãng 12 tháng'),
  };
  const jsonProps = JSON.stringify(heroProps).replace(/"/g, '&quot;');
%>
<section class="site-hero-wrapper" data-react="Hero" data-props="<%= jsonProps %>">
  <!-- Fallback Content for SEO & No-JS -->
  <noscript>
    <div class="container mx-auto px-4 py-6">
      <div class="rounded-2xl bg-gradient-to-r from-red-600 to-amber-600 p-8 text-white shadow-xl">
        <span class="inline-block px-3 py-1 bg-white/20 rounded-full text-xs font-semibold mb-3">Mới ra mắt</span>
        <h1 class="text-3xl font-black mb-2"><%= heroProps.title %></h1>
        <p class="text-base text-white/90 mb-4"><%= heroProps.subtitle %></p>
        <a href="#danh-muc" class="inline-block px-6 py-2.5 bg-white text-red-600 font-bold rounded-xl shadow hover:bg-slate-50 transition">
          Khám phá ngay
        </a>
      </div>
    </div>
  </noscript>
</section>
