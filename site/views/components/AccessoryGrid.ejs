<%
  const title = field('Title', 'Sắm thêm phụ kiện chất lượng');
  const accessories = [
    { name: 'Cáp, củ sạc', kind: 'charger', color: '#64748b' },
    { name: 'Pin dự phòng', kind: 'battery', color: '#0ea5e9' },
    { name: 'Tai nghe Bluetooth', kind: 'audio', color: '#f59e0b' },
    { name: 'Ốp lưng, bao da', kind: 'case', color: '#ec4899' },
    { name: 'Dán màn hình', kind: 'glass', color: '#10b981' },
    { name: 'Bàn phím, chuột', kind: 'keyboard', color: '#8b5cf6' },
  ];
%>
<section class="container mx-auto px-4 sm:px-6 lg:px-8 mt-10">
  <div class="flex items-center justify-between mb-4 border-b border-slate-200 pb-2">
    <h2 class="text-xl font-bold text-slate-900"><%= title %></h2>
    <a href="#accessory" class="text-xs font-semibold text-red-600 hover:text-red-700">Xem tất cả →</a>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3">
    <% accessories.forEach(acc => { %>
      <a
        href="#accessory"
        class="group flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white shadow-sm border border-slate-100 hover:shadow-md hover:border-red-200 transition-all"
      >
        <span class="w-12 h-12 rounded-lg bg-slate-50 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform mb-2">
          🔌
        </span>
        <span class="text-xs font-semibold text-slate-800 group-hover:text-red-600 transition-colors"><%= acc.name %></span>
      </a>
    <% }) %>
  </div>
</section>
